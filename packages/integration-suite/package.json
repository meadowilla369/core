{
  "name": "@ticket-platform/integration-suite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:services": "node tests/utils/build-services.mjs",
    "test": "npm run build:services && node --test --test-concurrency=1 tests/**/*.test.mjs",
    "test:critical": "npm run build:services && node --test --test-concurrency=1 tests/integration/critical-journeys.test.mjs",
    "test:backend": "npm run build:services && node --test --test-concurrency=1 tests/integration/backend-sandbox.test.mjs",
    "test:flow0": "npm run build:services && node --test --test-concurrency=1 tests/integration/flow0-registration-wallet-bootstrap.test.mjs",
    "test:flow1": "npm run build:services && node --test --test-concurrency=1 tests/integration/flow1-payment-purchase.test.mjs",
    "test:flow2": "npm run build:services && node --test --test-concurrency=1 tests/integration/flow2-resale-purchase.test.mjs",
    "test:flow4": "npm run build:services && node --test --test-concurrency=1 tests/integration/flow4-checkin.test.mjs",
    "test:flow5": "npm run build:services && node --test --test-concurrency=1 tests/integration/flow5-refund.test.mjs",
    "test:contract-sync": "npm run build:services && node --test --test-concurrency=1 tests/integration/contract-sync-service.test.mjs",
    "test:payment-orchestrator": "npm run build:services && node --test --test-concurrency=1 tests/integration/payment-orchestrator.test.mjs",
    "test:marketplace-service": "npm run build:services && node --test --test-concurrency=1 tests/integration/marketplace-service.test.mjs",
    "test:e2e": "npm run build:services && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:load": "npm run build:services && node --test --test-concurrency=1 tests/perf/load.test.mjs",
    "test:chaos": "npm run build:services && node --test --test-concurrency=1 tests/perf/chaos.test.mjs",
    "test:contracts": "node --test --test-concurrency=1 tests/contracts/*.test.mjs"
  }
}
