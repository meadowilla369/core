# Ticket Platform local development environment
# Copy to .env before running the local stack:
#   cp .env.example .env

# Shared host binding
HOST=127.0.0.1

# UI simulator
UI_HOST=127.0.0.1
UI_PORT=4310
UI_SKIP_BUILD=0

# Internal service auth
INTERNAL_API_KEY=internal-dev-key

# API gateway
# PORT is injected per-service by scripts/dev-stack.sh
REQUEST_TIMEOUT_MS=2000
AUTH_SERVICE_BASE_URL=http://127.0.0.1:3001
USER_SERVICE_BASE_URL=http://127.0.0.1:3002
KYC_SERVICE_BASE_URL=http://127.0.0.1:3003
EVENT_SERVICE_BASE_URL=http://127.0.0.1:3004
TICKETING_SERVICE_BASE_URL=http://127.0.0.1:3005
PAYMENT_ORCHESTRATOR_BASE_URL=http://127.0.0.1:3006
MARKETPLACE_SERVICE_BASE_URL=http://127.0.0.1:3007
CHECKIN_SERVICE_BASE_URL=http://127.0.0.1:3008
REFUND_SERVICE_BASE_URL=http://127.0.0.1:3009
RECOVERY_SERVICE_BASE_URL=http://127.0.0.1:3011
DISPUTE_SERVICE_BASE_URL=http://127.0.0.1:3012
NOTIFICATION_SERVICE_BASE_URL=http://127.0.0.1:3013
CONTRACT_SYNC_SERVICE_BASE_URL=http://127.0.0.1:3014

# Auth service
OTP_LENGTH=6
OTP_TTL_SEC=300
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_RATE_WINDOW_SEC=900
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
AUTH_EXPOSE_OTP_IN_RESPONSE=true

# KYC service
KYC_PROVIDER=fpt
KYC_FALLBACK_PROVIDER=vnpt
KYC_MIN_LIVENESS_SCORE=0.8
KYC_MIN_FACE_MATCH_SCORE=0.7

# Ticketing service
RESERVATION_TTL_SEC=900

# Payment orchestrator
ALLOWED_PAYMENT_GATEWAYS=momo,vnpay
MOMO_WEBHOOK_SECRET=momo_dev_secret
VNPAY_WEBHOOK_SECRET=vnpay_dev_secret
WEBHOOK_MAX_SKEW_SEC=300
WEBHOOK_NONCE_TTL_SEC=1800
MAX_WEBHOOK_RETRIES=5
RETRY_BASE_DELAY_SEC=30
BACKEND_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
TICKET_LEDGER_CHAIN_ID=84532
TICKET_LEDGER_ADDRESS=0x1000000000000000000000000000000000000001
PAYMENT_HASH_TTL_SEC=86400
WALLET_PREFUND_AMOUNT_WEI=1000000000000000
CAST_BINARY_PATH=cast

# Marketplace service
MAX_MARKUP_BPS=12000
PLATFORM_FEE_BPS=500
ORGANIZER_ROYALTY_BPS=200
MARKETPLACE_CHAIN_ID=84532
MARKETPLACE_ADDRESS=0x2000000000000000000000000000000000000002
BUY_HASH_TTL_SEC=86400

# Check-in service
QR_SIGNATURE_SECRET=checkin_dev_secret
MAX_QR_AGE_SEC=30
MAX_CLOCK_SKEW_SEC=10
MARK_AS_USED_POLL_MS=1000
MARK_AS_USED_MAX_RETRIES=3
MARK_AS_USED_FAILURE_RATE=0

# Refund service
PAYOUT_SYNC_POLL_MS=2000
MAX_REFUND_RETRY_COUNT=3
REFUND_RETRY_BASE_DELAY_SEC=30
PAYOUT_FAILURE_RATE=0

# Recovery service
RECOVERY_HOLD_DURATION_SEC=172800
REQUIRED_VERIFICATION_CHANNELS=2
ELIGIBILITY_SCAN_INTERVAL_MS=1000

# Dispute service
SLA_TIER1_HOURS=24
SLA_TIER2_HOURS=48
SLA_TIER3_HOURS=72

# Notification service
DELIVERY_POLL_MS=1000
MAX_NOTIFICATION_RETRIES=2
DELIVERY_FAILURE_RATE=0

# Worker mint
MAX_MINT_ATTEMPTS=5
MAX_MINT_BATCH_SIZE=10
TOKEN_ID_SEED=100000

# Contract sync (leave RPC_URL empty to disable live RPC listener in local mode)
CHAIN_ID=31337
RPC_URL=
TICKET_NFT_ADDRESS=0x3000000000000000000000000000000000000003
MARKETPLACE_ADDRESS=0x2000000000000000000000000000000000000002

# Docker Compose local infra
COMPOSE_PROJECT_NAME=ticket-platform-local
POSTGRES_PORT=5432
POSTGRES_DB=ticket_platform
POSTGRES_USER=ticket_platform
POSTGRES_PASSWORD=ticket_platform
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
