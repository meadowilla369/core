# Base Sepolia overrides for app/backend runtime.
# Local infra credentials come from .env.example; this file only carries
# service URLs, chain IDs, and contract addresses for Base Sepolia.

NODE_ENV=development
HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
AUTH_SERVICE_BASE_URL=http://localhost:3001
USER_SERVICE_BASE_URL=http://localhost:3002
KYC_SERVICE_BASE_URL=http://localhost:3003
EVENT_SERVICE_BASE_URL=http://localhost:3004
TICKETING_SERVICE_BASE_URL=http://localhost:3005
PAYMENT_ORCHESTRATOR_BASE_URL=http://localhost:3006
MARKETPLACE_SERVICE_BASE_URL=http://localhost:3007
CHECKIN_SERVICE_BASE_URL=http://localhost:3008
REFUND_SERVICE_BASE_URL=http://localhost:3009
RECOVERY_SERVICE_BASE_URL=http://localhost:3011
DISPUTE_SERVICE_BASE_URL=http://localhost:3012
NOTIFICATION_SERVICE_BASE_URL=http://localhost:3013
CONTRACT_SYNC_SERVICE_BASE_URL=http://localhost:3014
CONTRACT_SYNC_RPC_LISTENER_ENABLED=true
CONTRACT_SYNC_RPC_URL=wss://base-sepolia.infura.io/ws/v3/your-project-id
# Backend signer used by payment-orchestrator for purchase hash signing and wallet prefund.
# Use a dedicated Base Sepolia-funded key, or temporarily reuse the deployer key for demos.
BACKEND_SIGNER_PRIVATE_KEY=replace-me
RPC_URL=https://base-sepolia.infura.io/v3/87d8f0675c114566a395060f35a9b6fe
BASE_RPC_URL=https://base-sepolia.infura.io/v3/87d8f0675c114566a395060f35a9b6fe
PAYMENT_PROVIDER=momo
KYC_PROVIDER=fpt
