{
  "name": "ticket-platform-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Ticket platform monorepo skeleton (FE, BE, contracts, infra)",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "build": "PATH=\"$PWD/bin:$PATH\" turbo run build",
    "dev": "./scripts/dev-stack.sh infra-up && PATH=\"$PWD/bin:$PATH\" turbo run dev",
    "ui:dev": "node --env-file=.env apps/ui-simulator/server.mjs",
    "test": "PATH=\"$PWD/bin:$PATH\" turbo run test",
    "test:integration": "node scripts/run-integration-test.mjs",
    "test:integration-suite": "cd packages/integration-suite && npm run test",
    "test:integration:payment-orchestrator": "cd packages/integration-suite && npm run test:payment-orchestrator",
    "test:integration:marketplace-service": "cd packages/integration-suite && npm run test:marketplace-service",
    "lint": "PATH=\"$PWD/bin:$PATH\" turbo run lint",
    "typecheck": "PATH=\"$PWD/bin:$PATH\" turbo run typecheck",
    "format": "PATH=\"$PWD/bin:$PATH\" turbo run format",
    "format:write": "prettier . --write",
    "prepare": "husky",
    "stack:up": "./scripts/dev-stack.sh up",
    "stack:infra:up": "./scripts/dev-stack.sh infra-up",
    "stack:infra:down": "./scripts/dev-stack.sh infra-down",
    "stack:infra:status": "./scripts/dev-stack.sh infra-status",
    "db:reset": "./scripts/reset-db.sh",
    "db:test:schema": "node --test scripts/tests/schema-contract.test.mjs",
    "stack:down": "./scripts/dev-stack.sh down",
    "stack:status": "./scripts/dev-stack.sh status",
    "stack:logs": "./scripts/dev-stack.sh logs",
    "stack:smoke": "./scripts/dev-stack.sh smoke",
    "stack:base-sepolia:up": "STACK_ENV_FILE=config/environments/base-sepolia.env ./scripts/dev-stack.sh up",
    "stack:base-sepolia:down": "STACK_ENV_FILE=config/environments/base-sepolia.env ./scripts/dev-stack.sh down",
    "stack:base-sepolia:status": "STACK_ENV_FILE=config/environments/base-sepolia.env ./scripts/dev-stack.sh status",
    "stack:base-sepolia:logs": "STACK_ENV_FILE=config/environments/base-sepolia.env ./scripts/dev-stack.sh logs",
    "stack:base-sepolia:ios:up": "./scripts/base-sepolia-ios.sh up",
    "stack:base-sepolia:ios:build": "./scripts/base-sepolia-ios.sh build",
    "stack:base-sepolia:ios:web": "./scripts/base-sepolia-ios.sh web",
    "stack:base-sepolia:ios:live": "./scripts/base-sepolia-ios.sh live",
    "stack:base-sepolia:ios:sync": "./scripts/base-sepolia-ios.sh sync",
    "chain:up": "./scripts/localchain.sh up",
    "chain:deploy": "./scripts/localchain.sh deploy",
    "chain:down": "./scripts/localchain.sh down",
    "chain:status": "./scripts/localchain.sh status",
    "stack:localchain:up": "./scripts/localchain.sh full-up",
    "stack:localchain:ios:up": "./scripts/localchain-ios.sh up",
    "stack:localchain:down": "./scripts/localchain.sh full-down",
    "stack:localchain:smoke": "./scripts/localchain-smoke.sh",
    "ios:localchain:build": "./scripts/localchain-ios.sh build",
    "ios:localchain:open": "./scripts/localchain-ios.sh open",
    "ios:localchain:live": "./scripts/localchain-ios.sh live",
    "ios:localchain:sync": "./scripts/localchain-ios.sh sync",
    "web:localchain:ios:dev": "./scripts/localchain-ios.sh web",
    "web:localchain:dev": "./scripts/localchain.sh web",
    "contracts:deploy:base-sepolia": "./contracts/script/deploy-base.sh base-sepolia",
    "contracts:deploy:base-mainnet": "./contracts/script/deploy-base.sh base-mainnet",
    "contracts:sync:base-sepolia": "node scripts/sync-base-sepolia-deployment.mjs --network base-sepolia --deployment contracts/deployments/base-sepolia-addresses.json --registry contracts/deployments/address-registry.json --template config/environments/base-sepolia.env.example --env-output config/environments/base-sepolia.env",
    "contracts:test": "cd contracts && forge test --offline",
    "contracts:quality": "./scripts/run-contract-quality-gates.sh",
    "staging:parity": "./scripts/check-staging-parity.sh",
    "release:gate": "./scripts/release-candidate-gate.sh",
    "rollback:gate": "./scripts/incident-rollback-gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
