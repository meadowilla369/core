# Base Sepolia deploy config.
# Required wallets:
# - DEPLOY_ADMIN: contract owner/admin on Base Sepolia
# - PRIVATE_KEY: same wallet as DEPLOY_ADMIN for the deploy transaction, funded with Base Sepolia ETH
# Optional:
# - PAYMASTER_INITIAL_DEPOSIT: initial ETH top-up for TicketPaymaster

RPC_URL=https://sepolia.base.org
PRIVATE_KEY=replace-me
DEPLOY_ADMIN=0x0000000000000000000000000000000000000001
PAYMASTER_MAX_REFILL_PER_TX=10000000000000000
PAYMASTER_INITIAL_DEPOSIT=0
